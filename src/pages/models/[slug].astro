---
import Layout from '../../layouts/Layout.astro';
import Flow from '../../components/Flow.astro';
import {models,concepts,checked} from '../../data/catalog.mjs';
export function getStaticPaths(){return models.map(model=>({params:{slug:model.slug},props:{model}}));}
const {model:m}=Astro.props;const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title={m.name} description={m.lead}><div class="article-wrap"><a class="breadcrumb" href={`${base}#models`}>模型图谱 / {m.category}</a><header class="article-header"><span class="eyebrow">{m.family} · {m.kind}</span><h1>{m.name}</h1><p>{m.lead}</p><div class="facts">{m.facts.map(f=><span>{f}</span>)}</div></header><div class="scope"><strong>阅读范围</strong><p>{m.scope}</p></div><Flow model={m}/><div class="article-columns"><aside><strong>本页导读</strong><a href="#mechanism">核心机制</a>{m.slug==='minimax-h3'&&<a href="#full-diagram">完整结构图</a>}<a href="#exercise">自测练习</a><a href="#sources">源码与版本</a><hr/><strong>相关概念</strong>{m.concepts.map(c=><a href={`${base}concepts/${c}/`}>{concepts.find(x=>x.id===c)?.name}</a>)}</aside><article><div id="mechanism">{m.sections.map(([title,body])=><section class="prose-section"><h2>{title}</h2><p>{body}</p></section>)}</div>{m.slug==='minimax-h3'&&<section id="full-diagram" class="prose-section"><h2>从整体到 DiT block</h2><p>图中的形状来自实现默认值。箭头表示逻辑数据依赖，不表示设备划分或执行耗时。</p><a href={`${base}figures/minimax-h3.svg`} target="_blank" rel="noopener"><img class="full-diagram" src={`${base}figures/minimax-h3.svg`} alt="MiniMax-H3 条件编码、联合扩散、VAE 解码和 DiT 内部结构" loading="lazy"/></a><a class="text-link" href={`${base}figures/minimax-h3.svg`} download>下载可编辑 SVG</a></section>}<section id="exercise" class="exercise"><span class="eyebrow">停下来想一想</span><h2>{m.question}</h2><details><summary>展开参考答案</summary><p>{m.answer}</p></details></section><section id="sources" class="source-box"><h2>源码与版本</h2><p>核对日期：{checked}<br/>依据版本：<code>{m.revision}</code></p><ul>{m.sources.map(([name,url])=><li><a href={url} target="_blank" rel="noopener">{name} ↗</a></li>)}</ul></section><div class="next-reading"><span>继续探索</span>{models.filter(x=>x.slug!==m.slug).map(x=><a href={`${base}models/${x.slug}/`}>{x.name} ↗</a>)}</div></article></div></div></Layout>
