---
import Layout from '../layouts/Layout.astro';
import InfraMap from '../components/infra/InfraMap.jsx';
import { concepts } from '../data/catalog.mjs';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout immersive title="AI Infra Lab" description="在三维计算机房中探索模型、Attention、生成方法、并行通信与推理系统。">
  <InfraMap concepts={concepts} base={base} client:load />
  <noscript><p style="padding:24px">三维实验室需要 JavaScript。<a href={`${base}concepts/`}>打开完整概念目录</a></p></noscript>
</Layout>
