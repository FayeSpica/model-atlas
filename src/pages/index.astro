---
import Layout from '../layouts/Layout.astro';
import { RecipeCardGrid } from '../vendor/recipes/RecipeCardGrid.jsx';
import { recipes } from '../lib/recipes-ui.jsx';
---
<Layout title="模型架构">
  <div class="max-w-[1480px] mx-auto px-4 sm:px-6 py-8">
    <header class="mb-6"><h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">Model Atlas</h1><p class="text-sm text-muted-foreground max-w-3xl">模型结构图、张量形状与源码解析。</p></header>
    <RecipeCardGrid recipes={recipes} client:load />
  </div>
</Layout>
