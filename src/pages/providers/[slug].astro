---
import Layout from '../../layouts/Layout.astro';
import ModelRows from '../../components/ModelRows.astro';
import { providers } from '../../data/providers.mjs';
import { models } from '../../data/catalog.mjs';
import { getProviderLogo } from '../../vendor/recipes/providers.js';
export function getStaticPaths() { return providers.map(provider => ({ params: { slug: provider.id }, props: { provider } })); }
const { provider } = Astro.props;
const entries = models.filter(model => model.family === provider.name);
const categories = [...new Set(entries.map(model => model.category))];
const logo = getProviderLogo(provider.organization);
---
<Layout title={provider.name} sidebar provider={provider.id}>
  <div class="flex-1 min-w-0 py-8"><header class="flex items-center gap-4 mb-8">{logo ? <img src={logo} alt="" width="56" height="56" class="rounded-xl shrink-0"/> : <div class="w-14 h-14 rounded-xl bg-muted flex items-center justify-center text-xl font-bold text-muted-foreground">{provider.name.slice(0, 1)}</div>}<div><h1 class="text-2xl font-bold tracking-tight">{provider.name}</h1><div class="flex items-center gap-2 text-sm text-muted-foreground mt-1"><span class="font-mono text-xs">{provider.organization}</span><span>·</span><span>{entries.length} 篇解析</span></div></div></header><div class="space-y-8">{categories.map(category => <section><div class="flex items-center gap-2 mb-3"><h2 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">{category}</h2><span class="text-xs text-muted-foreground/60 tabular-nums">{entries.filter(model => model.category === category).length}</span></div><ModelRows models={entries.filter(model => model.category === category)} /></section>)}</div></div>
</Layout>
