 vLLM v0.8.0" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=32;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1340" height="55" as="geometry" /></mxCell><mxCell id="scope" value="Qwen2ForCausalLM · TP=1 shapes · N tokens / D hidden / F intermediate / V vocabulary" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1340" height="40" as="geometry" /></mxCell><mxCell id="overview" value="01  Model path — forward, compute_logits and sample are separate calls" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=21;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1340" height="38" as="geometry" /></mxCell><mxCell id="ids" value="input_ids&#10;[N]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f8f9;strokeColor=#c8cdd1;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="240" height="70" as="geometry" /></mxCell><mxCell id="embed" value="VocabParallelEmbedding&#10;[N, D]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="180" width="240" height="70" as="geometry" /></mxCell><mxCell id="layers" value="L × Qwen2DecoderLayer&#10;hidden_states + residual" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="240" height="70" as="geometry" /></mxCell><mxCell id="norm" value="Final RMSNorm&#10;add pending residual" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f8f9;strokeColor=#c8cdd1;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="855" y="180" width="240" height="70" as="geometry" /></mxCell><mxCell id="hidden" value="forward() returns&#10;[N, D] hidden states" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1130" y="180" width="240" height="70" as="geometry" /></mxCell><mxCell id="lm" value="compute_logits()&#10;LM head → [N_selected, V]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1130" y="290" width="240" height="65" as="geometry" /></mxCell><mxCell id="sample" value="sample()&#10;Sampler → next token" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="855" y="290" width="240" height="65" as="geometry" /></mxCell><mxCell id="globalnote" value="L, D, F, Hq and Hkv come from Qwen2Config.&#10;LM head shares embedding weights only if tie_word_embeddings=True.&#10;inputs_embeds bypasses embedding lookup; generation loop is outside this file." style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="280" width="780" height="80" as="geometry" /></mxCell><mxCell id="layerheading" value="02  Decoder layer — fused residual + RMSNorm" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=21;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="650" height="50" as="geometry" /></mxCell><mxCell id="attnheading" value="03  Qwen2Attention — QKV → RoPE → attention" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=21;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="395" width="640" height="50" as="geometry" /></mxCell><mxCell id="pair" value="Input pair: hidden_states h, residual r&#10;Both [N, D] when r exists" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="465" width="420" height="65" as="geometry" /></mxCell><mxCell id="inorm" value="input_layernorm&#10;r = h if r is None, else r + h&#10;a = RMSNorm(r)" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="575" width="420" height="100" as="geometry" /></mxCell><mxCell id="attention" value="self_attn(positions, a)&#10;attention output o: [N, D]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="725" width="420" height="65" as="geometry" /></mxCell><mxCell id="postnorm" value="post_attention_layernorm(o, r)&#10;r = r + o&#10;m = RMSNorm(r)" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="840" width="420" height="90" as="geometry" /></mxCell><mxCell id="mlp" value="Qwen2MLP(m)&#10;u = down_proj(SiLU(gate) ⊙ up)" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="980" width="420" height="65" as="geometry" /></mxCell><mxCell id="return" value="Return (u, r) — still two tensors&#10;MLP residual add occurs at next layer norm&#10;or at the final model norm" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="170" y="1095" width="420" height="75" as="geometry" /></mxCell><mxCell id="qkv" value="qkv_proj · QKVParallelLinear · bias=True&#10;[N, (Hq + 2Hkv) × d]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="790" y="465" width="520" height="65" as="geometry" /></mxCell><mxCell id="q" value="Q&#10;[N, Hq × d]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="760" y="585" width="170" height="60" as="geometry" /></mxCell><mxCell id="k" value="K&#10;[N, Hkv × d]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="960" y="585" width="170" height="60" as="geometry" /></mxCell><mxCell id="v" value="V&#10;[N, Hkv × d]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1160" y="585" width="170" height="60" as="geometry" /></mxCell><mxCell id="rope" value="rotary_emb(positions, q, k)&#10;RoPE on Q and K only" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="790" y="700" width="340" height="65" as="geometry" /></mxCell><mxCell id="kernel" value="Attention(q, k, v)&#10;Default: causal · scale = d^(-1/2)&#10;GQA when Hkv &lt; Hq" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="790" y="835" width="340" height="85" as="geometry" /></mxCell><mxCell id="cache" value="Per-layer KV cache&#10;+ attention metadata&#10;backend-managed" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1170" y="985" width="200" height="80" as="geometry" /></mxCell><mxCell id="outproj" value="o_proj · RowParallelLinear&#10;[N, Hq × d] → [N, D] · no bias" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#9cb6cd;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="790" y="985" width="340" height="65" as="geometry" /></mxCell><mxCell id="attnnotes" value="d = D / Hq; no Q/K RMSNorm in this implementation.&#10;TP shards Q heads; KV heads are sharded or replicated.&#10;KV cache is not an explicit Qwen2Attention.forward argument.&#10;is_causal=False selects ENCODER_ONLY attention instead." style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="730" y="1090" width="640" height="100" as="geometry" /></mxCell><mxCell id="mlpheading" value="04  Qwen2MLP — fused gate/up projection, dense SwiGLU" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=21;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1220" width="1340" height="45" as="geometry" /></mxCell><mxCell id="mlpin" value="m&#10;[N, D]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f8f9;strokeColor=#c8cdd1;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1300" width="200" height="65" as="geometry" /></mxCell><mxCell id="gateup" value="gate_up_proj · no bias&#10;MergedColumnParallelLinear" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="290" y="1300" width="310" height="65" as="geometry" /></mxCell><mxCell id="gate" value="gate: [N, F]&#10;linear projection" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="670" y="1270" width="240" height="60" as="geometry" /></mxCell><mxCell id="up" value="up: [N, F]&#10;identity" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=16;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="670" y="1370" width="240" height="60" as="geometry" /></mxCell><mxCell id="multiply" value="SiluAndMul&#10;SiLU(gate) ⊙ up&#10;[N, F]" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#f7f0e4;strokeColor=#bfa878;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="980" y="1300" width="160" height="100" as="geometry" /></mxCell><mxCell id="down" value="down_proj&#10;RowParallelLinear&#10;[N, D] · no bias" style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=#eef3eb;strokeColor=#a0b797;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=1;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="1200" y="1300" width="170" height="100" as="geometry" /></mxCell><mxCell id="footer" value="N = tokens processed in this call (vLLM flattened token layout), not a fixed batch × sequence tensor.&#10;Shapes above are logical TP=1 shapes. PP ranks pass hidden_states and residual between layer partitions.&#10;Source: vllm/model_executor/models/qwen2.py @ v0.8.0; RMSNorm and Attention internals checked at the same version.&#10;Embedding-model pooling path is excluded from this causal-LM diagram." style="rounded=1;absoluteArcSize=1;arcSize=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#232b31;fontSize=15;fontStyle=0;fontFamily=Inter, Arial, sans-serif;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="1340" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
